root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sln,vcxproj,vcxproj.filters,cmd,bat}]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_size = 2

[Source/Lua/Manifold/*.lua]
indent_size = 2

[Source/Syscalls/*]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[Dependencies/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
