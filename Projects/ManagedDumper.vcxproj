      <Message>Building the managed dumper and embedding it into the program</Message>
      <Inputs>$(ProjectDir)..\Managed\ManifoldDumper\Dumper.cs;$(ProjectDir)..\Managed\ManifoldDumper\ManifoldDumper.csproj;$(ProjectDir)..\Tools\embed_managed.py</Inputs>
