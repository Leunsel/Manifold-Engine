    <CheatEntry>
      <ID>7</ID>
      <Description>"Heal instead of damage"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
assert(TestTarget.Damage,29 11 C3)
alloc(newmem,$100,TestTarget.Damage)
label(code)

newmem:
code:
  add [rcx],edx
  ret

TestTarget.Damage:
  jmp newmem
registersymbol(code)

[DISABLE]
TestTarget.Damage:
  db 29 11 C3 CC CC

unregistersymbol(code)
dealloc(newmem)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>8</ID>
      <Description>"Lua: print the health"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
print("Health is " .. readInteger("[[TestTarget.g_world]+8]"))
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
print("Bye")
{$asm}
</AssemblerScript>
    </CheatEntry>
